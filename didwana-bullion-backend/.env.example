# PostgreSQL Connection String
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/didwana_bullion
# Cloud example (Render / Neon / Supabase): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/didwana_bullion

# Strong random secret for signing JWTs (at least 32 characters)
JWT_SECRET=change_this_to_a_long_random_64_char_secret_key_in_production
JWT_EXPIRES_IN=7d

# Server Port
PORT=5050

# Upstream Live Bullion Rates Feed
RATES_UPSTREAM_URL=https://glimmr-jewellry-e-commerce-platform-5.onrender.com
